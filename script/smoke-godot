#!/usr/bin/env python3
"""Run a short one-agent check against an exported Godot environment."""

import math
import os
import pathlib
import socket
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]


def main():
    env_path = os.environ.get("GODOT_ENV")
    if not env_path:
        raise SystemExit("Set GODOT_ENV to an exported Godot environment before running this check")

    sys.path.insert(0, str(ROOT))
    from godot_rl.core.godot_gym_env import GodotGymEnv

    port = int(os.environ.get("GODOT_RL_PORT", "12008"))
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as listener:
        listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        listener.bind(("127.0.0.1", port))

    environment = GodotGymEnv(env_path=env_path, port=port, seed=0, speedup=8)
    try:
        observation, info = environment.reset(seed=0)
        assert environment.observation_space.contains(observation)
        assert info == {}
        for _ in range(32):
            action = environment.action_space.sample()
            observation, reward, terminated, truncated, info = environment.step(action)
            assert environment.observation_space.contains(observation)
            assert isinstance(reward, float) and math.isfinite(reward)
            assert isinstance(terminated, bool)
            assert isinstance(truncated, bool)
            assert isinstance(info, dict)
    finally:
        environment.close()

    print("Godot RL one-agent smoke passed")


if __name__ == "__main__":
    main()
